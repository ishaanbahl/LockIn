{
  "expo": {
    "name": "Lok",
    "slug": "LockIn",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "lockin",
    "splash": {
      "image": "./assets/lok-mascot.png",
      "resizeMode": "contain",
      "backgroundColor": "#08542F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ishaanbahl.lockin",
      "infoPlist": {},
      "buildNumber": "8"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "./plugins/withScreenTime",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edc17324-8ded-4b1f-9a7a-b7911b141c3f"
      }
    }
  }
}
